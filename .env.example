# Copy to .env and adjust as needed. Defaults work with docker-compose.yml.
MATCHER_DSN=postgresql://postgres:postgres@localhost:5433/vehicles

# Optional LLM extraction tier (off by default; the matcher is fully functional without it).
# To enable: set true, add your key, and `pip install -e ".[llm]"`.
MATCHER_LLM_ENABLED=false
# ANTHROPIC_API_KEY=sk-ant-...
